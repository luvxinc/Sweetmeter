#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v py >/dev/null 2>&1; then
    exec py -3 scripts/versioning.py post-commit
elif command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/versioning.py post-commit
elif command -v python >/dev/null 2>&1; then
    exec python scripts/versioning.py post-commit
fi
echo "Sweetmeter could not validate this commit; install Python 3.10+." >&2
exit 1
