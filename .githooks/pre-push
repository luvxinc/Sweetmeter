#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v py >/dev/null 2>&1; then
    exec py -3 scripts/versioning.py pre-push "$@"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/versioning.py pre-push "$@"
elif command -v python >/dev/null 2>&1; then
    exec python scripts/versioning.py pre-push "$@"
fi
echo "Sweetmeter requires Python 3.10+ to validate outgoing commits." >&2
exit 1
